{
  "name": "Simulation",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "candidate_name": {
      "type": "string"
    },
    "candidate_user_id": {
      "type": "string"
    },
    "candidate_email": {
      "type": "string"
    },
    "candidate_phone": {
      "type": "string"
    },
    "candidate_resume_url": {
      "type": "string"
    },
    "candidate_profile_photo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed"
      ],
      "default": "in_progress"
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "disc_results": {
      "type": "object"
    },
    "disc_profile": {
      "type": "string"
    },
    "disc_answers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "disc_interpretation": {
      "type": "object"
    },
    "behavioral_profile": {
      "type": "object"
    },
    "integrity": {
      "type": "object"
    },
    "skill_scores": {
      "type": "object"
    },
    "score_confidence": {
      "type": "object"
    },
    "score_composition": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "skill_dna": {
      "type": "object"
    },
    "skill_graph": {
      "type": "object"
    },
    "demonstrated_levels": {
      "type": "object",
      "description": "N\u00edvel 0-10 demonstrado vs. exigido por compet\u00eancia"
    },
    "behavioral_observations": {
      "type": "object",
      "description": "Observa\u00e7\u00f5es de comportamento durante a simula\u00e7\u00e3o"
    },
    "overall_score": {
      "type": "number"
    },
    "overall_confidence": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "personality_analysis": {
      "type": "string"
    },
    "work_style": {
      "type": "string"
    },
    "strengths_detail": {
      "type": "string"
    },
    "weaknesses_detail": {
      "type": "string"
    },
    "profile_summary": {
      "type": "string"
    },
    "hard_skills": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "soft_skills": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "soft_skills_detail": {
      "type": "object",
      "description": "Detalhamento por soft skill e sub-dimens\u00e3o com scores e evid\u00eancias"
    },
    "soft_skills_narrative": {
      "type": "string",
      "description": "Par\u00e1grafo narrativo conectando as evid\u00eancias de soft skills"
    },
    "job_compatibility": {
      "type": "object"
    },
    "interview_questions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "consistency_analysis": {
      "type": "string"
    },
    "assessment_confidence": {
      "type": "object"
    },
    "ai_flags": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "focus_violations": {
      "type": "number",
      "default": 0
    },
    "hiring_status": {
      "type": "string",
      "enum": [
        "em_analise",
        "convocacao_entrevista",
        "entrevista_agendada",
        "aprovado",
        "reprovado"
      ],
      "default": "em_analise"
    },
    "hiring_notes": {
      "type": "string"
    },
    "total_time_seconds": {
      "type": "number"
    }
  },
  "required": [
    "job_id",
    "candidate_name"
  ]
}