{
  "name": "Job",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "area_description": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "company_context": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "company_problems": {
      "type": "string",
      "description": "Problema real que a pessoa contratada vai resolver"
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "competency_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "required_level": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "default": 7
          },
          "importance": {
            "type": "string",
            "enum": [
              "obrigatoria",
              "desejavel",
              "desenvolvivel"
            ],
            "default": "obrigatoria",
            "description": "Peso contextual: obrigatoria (peso 1.0), desejavel (0.6), desenvolvivel (0.3)"
          },
          "eliminatory": {
            "type": "boolean",
            "default": false,
            "description": "Se true, n\u00e3o atingir o n\u00edvel exigido pode eliminar automaticamente o candidato"
          }
        }
      },
      "description": "N\u00edvel exigido (0-10) e import\u00e2ncia por compet\u00eancia para a vaga"
    },
    "situations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Situa\u00e7\u00f5es reais escritas pela empresa"
    },
    "company_name": {
      "type": "string"
    },
    "openings": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero de vagas abertas para o cargo"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "closed"
      ],
      "default": "published"
    },
    "virtual_company_profile": {
      "type": "string"
    },
    "simulation_scenarios": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assessment": {
      "type": "object",
      "description": "Simula\u00e7\u00e3o v2: { version, source, generated_at, situations: [...] }"
    },
    "assessment_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "saved_at": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "situations_count": {
            "type": "number"
          },
          "note": {
            "type": "string"
          },
          "assessment": {
            "type": "object"
          }
        }
      },
      "description": "Hist\u00f3rico de vers\u00f5es anteriores da simula\u00e7\u00e3o \u2014 preservado quando a empresa regenera as perguntas ap\u00f3s candidatos j\u00e1 terem respondido"
    },
    "description": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "entry",
        "mid",
        "senior",
        "lead"
      ],
      "default": "mid",
      "description": "Legado \u2014 mantido para compatibilidade"
    },
    "seniority_level": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "default": 6,
      "description": "N\u00edvel de dom\u00ednio exigido (0-10) \u2014 substitui a senioridade fixa"
    },
    "process_depth": {
      "type": "string",
      "enum": [
        "leve",
        "padrao",
        "aprofundada",
        "personalizada"
      ],
      "default": "padrao",
      "description": "Profundidade do processo seletivo \u2014 define quantidade e complexidade da avalia\u00e7\u00e3o. A estrutura m\u00ednima (DISC + perguntas estruturadas + pelo menos 1 quest\u00e3o aberta) \u00e9 sempre obrigat\u00f3ria, independentemente do n\u00edvel."
    },
    "depth_custom": {
      "type": "object",
      "description": "Configura\u00e7\u00e3o personalizada quando process_depth='personalizada': { choiceCount, openCount }",
      "properties": {
        "choiceCount": {
          "type": "number"
        },
        "openCount": {
          "type": "number"
        }
      }
    },
    "resume_required": {
      "type": "boolean",
      "default": true,
      "description": "Se o envio de curr\u00edculo \u00e9 obrigat\u00f3rio (true) ou opcional (false) para se candidatar a esta vaga"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}