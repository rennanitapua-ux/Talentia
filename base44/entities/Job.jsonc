{
  "name": "Job",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "area_description": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "company_context": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "company_problems": {
      "type": "string",
      "description": "Problema real que a pessoa contratada vai resolver"
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "situations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Situa\u00e7\u00f5es reais escritas pela empresa"
    },
    "company_name": {
      "type": "string"
    },
    "openings": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero de vagas abertas para o cargo"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "closed"
      ],
      "default": "published"
    },
    "virtual_company_profile": {
      "type": "string"
    },
    "simulation_scenarios": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assessment": {
      "type": "object",
      "description": "Simula\u00e7\u00e3o v2: { version, source, situations: [...] }"
    },
    "description": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "entry",
        "mid",
        "senior",
        "lead"
      ],
      "default": "mid"
    }
  },
  "required": [
    "title"
  ]
}